# PyInstaller spec: build with  .venv\Scripts\pyinstaller PandaLoader.spec
# Produces a single dist\PandaLoader.exe (windowed, no console). The exe unpacks
# its runtime to a temp folder at launch, so one stable path for the firewall rule.
from PyInstaller.utils.hooks import collect_submodules
import re
from pathlib import Path

# Version resource (file properties of the exe) from pandaloader/__init__.py.
_ver = re.search(r'__version__ = "([^"]+)"', Path("pandaloader/__init__.py").read_text()).group(1)
_tuple = tuple(int(x) for x in (_ver.split(".") + ["0", "0", "0"])[:4])
Path("version_info.py").write_text(f"""# generated by PandaLoader.spec from pandaloader.__version__; not committed
VSVersionInfo(
  ffi=FixedFileInfo(filevers={_tuple}, prodvers={_tuple}, mask=0x3f, flags=0x0, OS=0x40004, fileType=0x1, subtype=0x0, date=(0, 0)),
  kids=[
    StringFileInfo([StringTable("040904B0", [
      StringStruct("CompanyName", "PPGdevGM2"),
      StringStruct("FileDescription", "PandaLoader render queue manager for DAZ Studio 6"),
      StringStruct("FileVersion", "{_ver}"),
      StringStruct("InternalName", "PandaLoader"),
      StringStruct("LegalCopyright", "MIT License"),
      StringStruct("OriginalFilename", "PandaLoader.exe"),
      StringStruct("ProductName", "PandaLoader"),
      StringStruct("ProductVersion", "{_ver}"),
    ])]),
    VarFileInfo([VarStruct("Translation", [1033, 1200])]),
  ],
)
""", encoding="utf-8")

block_cipher = None

a = Analysis(
    ["launcher.py"],
    pathex=["."],
    binaries=[],
    datas=[("pandaloader/web/static", "pandaloader/web/static")],
    hiddenimports=collect_submodules("pystray") + ["PIL.Image", "PIL.ImageDraw", "tkinter", "tkinter.simpledialog"],
    hookspath=[],
    runtime_hooks=[],
    excludes=["pytest", "py_spy", "fitz", "pymupdf"],
    cipher=block_cipher,
    noarchive=False,
)
pyz = PYZ(a.pure, a.zipped_data, cipher=block_cipher)

exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.zipfiles,
    a.datas,
    [],
    name="PandaLoader",
    debug=False,
    strip=False,
    upx=False,
    console=False,
    icon="pandaloader/web/static/favicon.ico",
    version="version_info.py",
)
